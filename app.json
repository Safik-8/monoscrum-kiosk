{
  "expo": {
    "name": "MonoScrum Attendance Kiosk",
    "slug": "monoscrum-kiosk-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logofinal.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monoscrum.kiosk",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow MonoScrum Attendance Kiosk to scan faces for attendance."
      }
    },
    "android": {
      "package": "com.monoscrum.kiosk",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logofinal.png",
        "backgroundImage": "./assets/logofinal.png",
        "monochromeImage": "./assets/logofinal.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/logofinal.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "e8d44179-fb16-413d-b22d-fc1c588c8f66"
      }
    },
    "owner": "safik-8s-team"
  }
}
